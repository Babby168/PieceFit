<div class="pt-4 border-t border-base-300 text-center space-y-1">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to "ログイン", new_session_path(resource_name), class: "link link-hover font-bold" %></p>
  <% end %>
  
  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to "アカウント作成", new_registration_path(resource_name), class: "link link-hover font-bold" %></p>
  <% end %>
  
  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' && controller_name != 'sessions' %>
    <p><%= link_to "パスワードを忘れた方はこちら", edit_password_reset_path, class: "link link-hover text-xs text-base-content/60" %></p>
  <% end %>
  
  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "確認メールが届かない方はこちら", new_confirmation_path(resource_name), class: "link link-hover text-xs text-base-content/60" %></p>
  <% end %>
  
  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "アカウントを解除した方はこちら", new_unlock_path(resource_name), class: "link link-hover text-xs text-base-content/60" %></p>
  <% end %>
  
  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p><%= button_to "ログイン", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "link link-hover text-xs text-content/60" %></p>
    <% end %>
  <% end %>
</div>
