<div class="flex flex-col items-center px-4">
  <div class="w-full max-w-6xl flex justify-between items-center mb-6 link-secondary">
    <%# マイページ実装後、マイページ経由で来た場合はマイページに戻るよう分岐を追加予定 %>
    <%=  link_to "← 部位選択に戻る", stretches_path, class: "text-sm font-bold link" %>

    <%=  render "shared/breadcrumb", items: [
      { label: "トップ", path: root_path },
      { label: "部位選択", path: stretches_path },
      { label: "ストレッチ選択", path: nil }
    ] %>
  </div>

  <%# ストレッチ選択タイトル %>
  <h1 class="text-2xl font-bold mb-10">ストレッチを選んでください</h1>

  <%# ストレッチカードグリッド %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-20 md:gap-30 max-w-6xl w-full">
    
    <%# ストレッチカード %>
    <% @stretches.each do |stretch| %>
      <%= link_to stretch_path(stretch), class: "card #{body_part_color(stretch.body_part)} shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] border-4 p-6 items-center text-center hover:brightness-95 transition" do %>
        <%# ストレッチキービジュアル %>
        <div class="w-full max-w-xs mx-auto aspect-square md:max-h-56 flex items-center justify-center mb-4 bg-gray-100 rounded-lg overflow-hidden">
          <%= image_tag stretch.key_visual_path, alt: stretch.name, class: "w-full h-full object-cover" %>
        </div>

        <%# ストレッチ名 %>
        <h2 class="text-2xl font-bold mb-2"><%= stretch.name %></h2>

        <%# ストレッチ説明 %>
        <p class="text-sm text-base-content/70"><%= stretch.description %></p>
      <% end %>
    <% end %>

    <%# 本リリースに向けて今後ストレッチの選択肢を追加予定であることを示すプレースホルダーカード %>
    <div class="card border-2 border-dashed border-gray-400 p-6 items-center text-center opacity-50 pointer-events-none select-none">
      <div class="w-full max-w-xs mx-auto aspect-square flex items-center justify-center mb-4 bg-gray-100 rounded-lg overflow-hidden">
        <span class="text-6xl text-gray-400">+</span>
      </div>
      <h2 class="text-2xl font-bold text-gray-400">近日追加予定</h2>
    </div>

  </div>
</div>
