<div class="min-h-screen flex flex-col items-center px-4 mt-10">
  <div class="w-full max-w-6xl flex justify-between items-center mb-6 link-secondary">
    <%= link_to "← ストレッチ選択に戻る", stretches_path(body_part: @stretch.body_part), class: "text-sm font-bold link" %>

    <%= render "shared/breadcrumb", items: [
      { label: "トップ", path: root_path },
      { label: "部位選択", path: stretches_path },
      { label: "ストレッチ選択", path: stretches_path(body_part: @stretch.body_part) },
      { label: "ストレッチ実施", path: nil }
    ] %>
  </div>

  <div
    class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-6 gap-6 max-w-6xl w-full mb-10"
    data-controller="stretch-log-dialog"
    data-stretch-log-dialog-stretch-id-value="<%= @stretch.id %>"
  >

    <%# ストレッチ詳細：キービジュアル＋手順文（自動スライドショー対応） %>
    <div 
      class="md:col-span-2 md:row-span-6 card <%= body_part_color(@stretch.body_part) %> shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] border-4 p-6"
      data-controller="illustration-slideshow"
      data-illustration-slideshow-images-value="<%= @stretch.stretch_steps.map { |step| asset_path(step.image_path) }.to_json %>"
      data-illustration-slideshow-key-visual-value="<%= asset_path(@stretch.key_visual_path) %>"
      data-illustration-slideshow-loops-value="2"
      data-illustration-slideshow-interval-value="<%= (60.0 / (@stretch.stretch_steps.size * 2)).round(2) %>"
      data-action="countdown-timer:start@window->illustration-slideshow#start countdown-timer:complete@window->illustration-slideshow#stop countdown-timer:reset@window->illustration-slideshow#reset"
    >
      <div class="w-full w-full flex items-center justify-center mb-4 bg-gray-100 rounded-lg overflow-hidden border-3 border-black">
        <%= image_tag @stretch.key_visual_path, alt: @stretch.name, class: "w-full h-full object-cover transition-opacity duration-200 ease-in-out", data: { illustration_slideshow_target: "image" } %>
      </div>
    
      <h1 class="text-4xl font-bold p-4 text-center"><%= @stretch.name %></h1>
      
      <div class="mt-4 mb-8 bg-white p-8 rounded-lg border-3 border-black">   
        <h2 class="text-lg font-bold mb-4 border-b-2 border-black pb-2">ストレッチの手順</h2>
        
        <ol class="list-decimal list-inside space-y-8 text-base-content/80">
          <% @stretch.stretch_steps.each do |step| %>
            <li data-illustration-slideshow-target="step" class="transition-all duration-300 ease-in-out rounded-lg p-2"><%= step.description %></li>
          <% end %>
        </ol>
      </div>
    </div>

    <%# カウントダウンタイマー（動作実装は別issueで対応。「中止」ボタンはタイマー開始時にJSで表示予定） %>
    <div 
      class="md:row-span-3 card bg-base-100 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] border-4 p-8 flex flex-col items-center justify-center gap-4"
      data-controller="countdown-timer"
      data-countdown-timer-duration-value="60"
    >
      <h2 class="text-2xl font-bold mb-2 text-center">残り時間</h2>
      <div class="p-8 mb-4 border-4 border-black rounded-lg w-full text-center">
        <p class="text-6xl font-bold tabular-nums" data-countdown-timer-target="time">01:00</p>
      </div>

      <div class="flex gap-2 justify-center w-full">
        <button
          type="button"
          class="btn btn-primary w-full h-15"
          data-countdown-timer-target="startButton"
          data-action="click->countdown-timer#start"
        >スタート</button>

        <button 
          type="button"
          class="btn btn-soft btn-secondary w-full h-15 hidden"
          data-countdown-timer-target="abortButton"
          data-action="click->stretch-log-dialog#openAbortConfirm"
        >中止</button>
      </div>
      <button
        type="button"
        class="btn btn-info w-full h-15"
        data-action="click->countdown-timer#reset"
      >リセット</button>
    </div>
    
    <%# 意識するポイント %>
    <div class="md:row-span-1 card bg-base-100 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] border-4 p-6">
      <h2 class="text-lg font-bold mb-2">意識するポイント</h2>
      <% if @stretch.point.present? %>
        <p class="text-base-content/80"><%= @stretch.point %></p>
      <% end %>
    </div>

    <%# ストレッチ完了モーダル（モーダルのテンプレートをパーシャル化） %>
    <%= render "shared/feedback_modal",
      title: "ストレッチ完了！",
      messages: [
        "お疲れ様でした。",
        "ピースを獲得しました！"
      ],
      html: { data: { stretch_log_dialog_target: "completeDialog" } } do %>
      <button
        type="button"
        class="btn btn-primary"
        data-action="click->stretch-log-dialog#recordAndRedirect"
      >マイページで確認する</button>
    <% end %>

    <%# ストレッチ中止モーダル（モーダルのテンプレートをパーシャル化） %>
    <%= render "shared/feedback_modal",
      title: "ストレッチを中止しますか？",
      messages: ["中止すると、ここまでの実施が記録されます。"],
      html: { data: { stretch_log_dialog_target: "abortDialog" } } do %>
      <button
        type="button",
        class="btn btn-ghost",
        data-action="click->stretch-log-dialog#closeAbortConfirm"
      >キャンセル</button>
      <button
        type="button",
        class="btn-btnsecondary",
        data-action="click->stretch-log-dialog#recordAndRedirect"
      >中止する</button>
    <% end %>
  </div>
</div>