<!DOCTYPE html>
<html lang="ja" data-theme="light">
  <head>
    <title><%= content_for(:title) || "PieceFit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PieceFit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# ファビコン設定 %>
    <%= favicon_link_tag "favicon/favicon.ico" %>

    <link rel="icon" type="image/png" sizes="96x96"
          href="<%= asset_path("favicon/favicon-96x96.png") %>">

    <link rel="icon" type="image/svg+xml"
          href="<%= asset_path("favicon/favicon.svg") %>">

    <link rel="apple-touch-icon"
          href="<%= asset_path("favicon/apple-touch-icon.png") %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-dvh flex flex-col">
    <%= render "shared/header" %>
    <main class="flex-1 flex flex-col">
      <% if flash[:notice] || flash[:alert].present? %>
        <div class="max-w-6xl mx-auto px-4 pt-4">
          <%= render "shared/flash_messages" %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
