<!DOCTYPE html>
<html lang="ja" data-theme="light">
  <head>
    <title><%= content_for(:title) || "PieceFit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="PieceFit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Analytics -->
    <% if (measurement_id = google_analytics_measurement_id) %>
      <%= render "shared/google_analytics", measurement_id: measurement_id %>
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# ファビコン設定 %>
    <%= favicon_link_tag "favicon/favicon.ico" %>

    <link rel="icon" type="image/png" sizes="96x96"
          href="<%= asset_path("favicon/favicon-96x96.png") %>">

    <link rel="icon" type="image/svg+xml"
          href="<%= asset_path("favicon/favicon.svg") %>">

    <link rel="apple-touch-icon"
          href="<%= asset_path("favicon/apple-touch-icon.png") %>">

    <%# 全ページ共通の背景画像 %>
    <%= stylesheet_link_tag "application", media: "all" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-dvh flex flex-col piecefit-background"
        data-controller="reminder"
        data-reminder-message-url-value="<%= reminder_message_path %>"
  >
    <%= render "shared/header" %>
    <main class="flex-1 flex flex-col">
      <% if flash[:notice] || flash[:alert].present? %>
        <div class="max-w-6xl mx-auto px-4 pt-4">
          <%= render "shared/flash_messages" %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>

    <%# リマインド発火時の画面内通知（初期状態は非表示） %>
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[min(92vw,28rem)] hidden"
         data-reminder-target="banner">
      <div class="card bg-warning text-warning-content border-4 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-4">
        <div class="flex items-start gap-3">
          <%= icon "timer", class: "size-8 shrink-0", "aria-hidden": true %>
          <div class="text-left flex-1">
            <p class="font-bold text-lg" data-reminder-target="bannerTitle"></p>
            <p class="text-sm" data-reminder-target="bannerBody"></p>
          </div>
        </div>
        <div class="flex gap-2 justify-end mt-3">
          <button type="button" class="btn btn-ghost btn-sm" data-action="click->reminder#closeBanner">閉じる</button>
          <%= link_to "ストレッチする", stretches_path, class: "btn btn-neutral btn-sm" %>
        </div>
      </div>
    </div>
  </body>
</html>
