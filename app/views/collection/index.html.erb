<div class="flex flex-col items-center px-4 mb-4">
  <div class="w-full max-w-6xl flex justify-between items-center mb-6 link-secondary">
    <%= link_to "← マイページに戻る", mypage_path, class: "text-sm font-bold link" %>
    
    <%= render "shared/breadcrumb", items: [
      { label: "ホーム", path: root_path },
      { label: "マイページ", path: mypage_path },
      { label: "モザイクコレクション", path: nil }
      ] %>
  </div>

  <div class="w-full max-w-6xl">
    <h1 class="text-2xl font-bold mb-2">モザイクコレクション</h1>
    <p class="text-sm text-base-content/60 mb-8">
      シリーズごとの枠に、完成したモザイクアートが埋まっていきます。
    </p>

    <% unless @has_completed_art %>
      <div class="mb-8">
        <p class="font-bold mb-2">まだ完成した作品はありません。</p>
        <p class="text-sm text-base-content/60 mb-6">
          ストレッチを続けて、最初のモザイクアートを完成させましょう。
        </p>
        <%= link_to "ストレッチを始める", stretches_path, class: "btn btn-primary" %>
      </div>
    <% end %>

    <% @shelves.each do |shelf| %>
      <section class="mb-10">
        <h2 class="text-lg font-bold mb-3"><%= shelf[:series_name] %></h2>
        <div class="flex gap-4 overflow-x-auto pb-4">
          <% shelf[:slots].each do |slot| %>
            <% if slot[:mosaic_art] %>
              <%= render "collection/card", mosaic_art: slot[:mosaic_art] %>
            <% else %>
              <%= render "collection/empty_card" %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
