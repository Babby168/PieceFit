<div class="min-h-screen flex flex-col items-center justify-center">
  <div class="w-full max-w-md">
    <%= link_to "← 戻る", profile_settings_path, class: "text-sm font-bold link mb-4 inline-block" %>

    <div class="border border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] bg-base-100 p-8 rounded-box">
      <h2 class="text-center font-bold text-2xl mb-4">パスワードの変更</h2>
      <p class="text-center text-sm mb-4">アカウントのセキュリティを保つため、定期的な変更をお勧めします。</p>
      
      <%= form_with model: @user, url: password_change_path, method: :patch do |f| %>

      <% if @user.errors.any? %>
        <div class="alert alert-error mb-4 rounded-box">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

        <%# 現在のパスワード %>
        <div class="field mb-4">
          <div class="flex justify-between items-center">
            <label class="label">
              <span class="label-text"><%= f.label :current_password, "現在のパスワード" %></span>
            </label>
          </div>
          <%= f.password_field :current_password,
                # 入力フィールドにフォーカスを当てる
                autofocus: true,
                # 必須項目
                required: true,
                # プレースホルダー
                placeholder: "現在のパスワードを入力",
                # 入力フィールドのスタイル
                class: "input w-full" %>
        </div>

        <%# 新しいパスワード %>
        <div class="field mb-4">
          <div class="flex justify-between items-center">
            <label class="label">
              <span class="label-text"><%= f.label :password, "新しいパスワード" %></span>
            </label>
          </div>
          <%= f.password_field :password,
                required: true,
                placeholder: "新しいパスワードを入力",
                class: "input w-full" %>
        </div>

        <%# 新しいパスワードの確認 %>
        <div class="field mb-4">
          <div class="flex justify-between items-center">
            <label class="label">
              <span class="label-text"><%= f.label :password_confirmation, "新しいパスワードの確認" %></span>
            </label>
          </div>
          <%= f.password_field :password_confirmation,
                required: true,
                placeholder: "新しいパスワードを再度入力",
                class: "input w-full" %>
        </div>
      
        <%# 変更を保存するボタン %>
        <div class="actions">
          <%= f.submit "変更する", class: "btn btn-primary w-full mb-8" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
