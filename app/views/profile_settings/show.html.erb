<div class="flex flex-col items-center px-4 mb-4">
  <div class="w-full max-w-6xl flex justify-between items-center mb-6 link-secondary">
    <%= link_to "← マイページに戻る", mypage_path, class: "text-sm font-bold link" %>
    
    <%= render "shared/breadcrumb", items: [
      { label: "ホーム", path: root_path },
      { label: "マイページ", path: mypage_path },
      { label: "プロフィール設定", path: nil }
      ] %>
  </div>

  <div class="w-full max-w-2xl">
    <h1 class="text-2xl font-bold mb-2">プロフィール設定</h1>
    <p class="text-sm text-base-content/60 mb-8">
      アカウント情報の確認と変更ができます。
    </p>

    <%# 設定項目 %>
    <div class="space-y-6">
      <%# setting_item パーシャルで設定項目を表示 %>
      <%# ニックネーム変更ページ %>
      <%= render "profile_settings/setting_item",
      path: edit_nickname_change_path,
      title: "ニックネーム",
      subtitle: current_user.nickname %>

      <%# メールアドレス変更ページ %>
      <%= render "profile_settings/setting_item",
      path: edit_email_change_path,
      title: "メールアドレス",
      subtitle: current_user.email %>

      <%# パスワード変更ページは issue #49 で実装 %>
      <%= render "profile_settings/setting_item",
      path: edit_password_change_path,
      title: "パスワードの変更",
      subtitle: "********" %>

      <%# アカウント削除ページは issue #51 で実装 %>
      <%= render "profile_settings/setting_item",
      path: account_delete_path,
      title: "アカウントの削除",
      subtitle: "この操作は取り消せません。全てのデータが失われます。",
      destructive: true %>
    </div>
  </div>
</div>
