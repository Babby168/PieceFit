<div class="max-w-6xl mx-auto px-4 py-10">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">マイページ</h1>
    <%= render "shared/breadcrumb", items: [
      { label: "ホーム", path: root_path },
      { label: "マイページ", path: nil }
    ] %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%# 左カラム %>
    <div class="space-y-6">
      <%= render "mypage/profile" %>
      <%= render "mypage/streak", streak_days: @streak_days %>
    </div>

    <%# 右カラム（モザイク＋履歴） %>
    <div class="md:col-span-2 space-y-6">
      <%= render "mosaic_arts/grid",
        # モザイクアートのデザイン情報
        mosaic_design: @mosaic_design,
        # デザインピースの情報
        design_pieces_by_position: @design_pieces_by_position,
        # ピースの獲得状況
        pieces_by_position: @pieces_by_position %>

        <%= render "mypage/history", stretch_logs: @stretch_logs %>
    </div>
  </div>
  

  <%# ボーナスピース獲得モーダル %>
  <% if flash[:streak_bonus_days].present? %>
    <dialog
      class="modal"
      data-controller="auto-open-dialog"
    >
      <div class="modal-box">
        <h3 class="text-lg font-bold">ボーナスピース獲得！</h3>
        <p class="py-4"><%= flash[:streak_bonus_days] %>日間連続達成ボーナスとして、</p>
        <p class="py-4 font-bold text-success">新しいピースを1つ獲得しました！</p>
        <div class="modal-action">
          <button
            type="button"
            class="btn btn-success"
            data-action="click->auto-open-dialog#close"
          >OK</button>
        </div>
      </div>
    </dialog>
  <% end %>
</div>
