<div class="max-w-6xl mx-auto px-4 py-4" data-controller="confirm-dialog">
  <h1 class="text-2xl font-bold mb-6">マイページ</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%# 左カラム %>
    <div class="space-y-6">
      <%= render "mypage/profile" %>
      <%= link_to "ストレッチを始める", stretches_path, class: "btn btn-primary btn-lg w-full" %>
      <%= render "mypage/streak", streak_days: @streak_days %>
      <button
        type="button"
        class="card bg-base-100 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] border-2 border-error p-4 hover:brightness-95 transition w-full"
        data-action="click->confirm-dialog#open"
      >
        <div class="flex-1">
          <p class="font-bold text-error">ログアウト</p>
        </div>
      </button>
    </div>

    <%# 右カラム（モザイク＋履歴） %>
    <div class="md:col-span-2 space-y-6">
      <%= render "mosaic_arts/grid",
        # モザイクアートのデザイン情報
        mosaic_design: @mosaic_design,
        # デザインピースの情報
        design_pieces_by_position: @design_pieces_by_position,
        # ピースの獲得状況
        pieces_by_position: @pieces_by_position %>

        <%= render "mypage/history", stretch_logs: @stretch_logs %>
    </div>
  </div>

  <!-- ログアウトモーダル -->
  <%= render "shared/feedback_modal",
    title: "ログアウトしますか？",
    messages: ["ログアウトすると、再度ログインが必要になります。"],
    html: { data: { confirm_dialog_target: "dialog" } } do %>
    <button
      type="button"
      class="btn btn-ghost"
      data-action="click->confirm-dialog#close"
    >キャンセル</button>
    <%= button_to "ログアウト",
      destroy_user_session_path,
      method: :delete,
      class: "btn btn-primary" %>
  <% end %>

  <%# ボーナスピース獲得モーダル（モーダルのテンプレートをパーシャル化） %>
  <%# streak_bonus_days（連続達成日数）が存在する場合に表示 %>
  <% if flash[:streak_bonus_days].present? %>
    <%= render "shared/feedback_modal",
      title: "ボーナスピース獲得！",
      messages: [
        "#{flash[:streak_bonus_days]}日間連続達成ボーナスとして、",
        "新しいピースを1つ獲得しました！",
      ],
      html: { data: { controller: "auto-open-dialog"}} do %>
      <button
        type="button"
        class="btn btn-primary"
        data-action="click->auto-open-dialog#close"
      >OK</button>
    <% end %>
  <% end %>

  <% if flash[:mosaic_completed].present? %>
    <%= render "shared/feedback_modal",
      title: "モザイクアート完成！",
      messages: [
        "おめでとうございます！",
        "すべてのピースが埋まりました！"
      ],
      html: { data: { controller: "auto-open-dialog" } } do %>
      <button
        type="button"
        class="btn btn-primary"
        data-action="click->auto-open-dialog#close"
      >OK</button>
    <% end %>
  <% end %>
</div>
