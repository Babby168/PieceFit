<div class="max-w-6xl mx-auto px-4 py-4">
  <h1 class="text-2xl font-bold mb-6">マイページ</h1>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <%# 左カラム（プロフィール＋連続日数） %>
    <div class="space-y-6 md:col-span-1">
      <%= render "mypage/profile" %>
      <%= render "mypage/streak", streak_days: @streak_days %>
    </div>

    <%# 中カラム（モザイク） %>
    <div class="md:col-span-2 space-y-6">
      <%= render "mosaic_arts/grid",
        # モザイクアートの情報
        mosaic_art: @mosaic_art,
        # モザイクアートのデザイン情報
        mosaic_design: @mosaic_design,
        # デザインピースの情報
        design_pieces_by_position: @design_pieces_by_position,
        # ピースの獲得状況
        pieces_by_position: @pieces_by_position %>
    </div>

    <%# 右カラム（履歴） %>
    <div class="md:col-span-1 space-y-6">
      <%= render "mypage/history",
              stretch_logs: @stretch_logs,
              body_part_counts: @body_part_counts %>
    </div>
  </div>

  <%# ボーナスピース獲得モーダル（モーダルのテンプレートをパーシャル化） %>
  <%# streak_bonus_days（連続達成日数）が存在する場合に表示 %>
  <% if flash[:streak_bonus_days].present? %>
    <%= render "shared/feedback_modal",
      title: "ボーナスピース獲得！",
      messages: [
        "#{flash[:streak_bonus_days]}日間連続達成ボーナスとして、",
        "新しいピースを1つ獲得しました！",
      ],
      html: { data: { controller: "auto-open-dialog"}} do %>
      <button
        type="button"
        class="btn btn-primary"
        data-action="click->auto-open-dialog#close"
      >OK</button>
    <% end %>
  <% end %>

  <% if flash[:mosaic_completed].present? %>
    <%= render "shared/feedback_modal",
      title: "モザイクアート完成！",
      messages: [
        "おめでとうございます！",
        "すべてのピースが埋まりました！"
      ],
      html: { data: { controller: "auto-open-dialog" } } do %>
      <button
        type="button"
        class="btn btn-primary"
        data-action="click->auto-open-dialog#close"
      >OK</button>
    <% end %>
  <% end %>
</div>
